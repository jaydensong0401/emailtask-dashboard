# ═══ 메일 수집 경로 ═══════════════════════════════════════════════
# imap : 앱 등록 불필요. 관리자가 IMAP 허용만 해주면 됨 (권장)
# api  : Developer Console 앱 필요 (관리자 권한 + Standard 이상 플랜)
MAIL_SOURCE=imap

# ── [MAIL_SOURCE=imap] ──
# 관리자: Admin > 보안 > 서비스 권한 에서 IMAP/SMTP 허용
# 2단계 인증 사용 시 앱 비밀번호를 넣으세요
NW_IMAP_USER=you@yourcompany.com
NW_IMAP_PASSWORD=

# ── [MAIL_SOURCE=api] ──
NW_CLIENT_ID=
NW_CLIENT_SECRET=
NW_REDIRECT_URI=https://localhost:8443/callback
NW_SCOPE=mail.read


# ═══ 요약 백엔드 ══════════════════════════════════════════════════
# rules       LLM 없음.  0원. 오프라인. 정확도 낮음. 설정 불필요
# claude_code 설치된 Claude Code CLI. 구독에 포함 → 추가 과금 없음 (권장)
# ollama      로컬 모델. 0원. ollama 설치 필요
# api         Anthropic API. 종량 과금. 정확도 최고
SUMMARY_BACKEND=claude_code

# ── [SUMMARY_BACKEND=claude_code] ──
# 비워두면 Claude Code 기본 모델을 씁니다.
# 사용량을 아끼려면 claude-haiku-4-5 처럼 가벼운 모델을 지정하세요.
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT=300

# ── [SUMMARY_BACKEND=ollama] ──
# 설치: https://ollama.com  →  ollama pull qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=600

# ── [SUMMARY_BACKEND=api] ── 여기만 돈이 나갑니다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5


# ═══ 대시보드 서버 ════════════════════════════════════════════════
# http://127.0.0.1:포트 로 대시보드를 연다 (이 PC 에서만 접속). 완료·제외·업무삭제 기록 저장
DASHBOARD_PORT=8787
